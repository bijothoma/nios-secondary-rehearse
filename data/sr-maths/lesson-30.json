        {
          "id": "1.1",
          "type": "mcq",
          "q": "If ∫2ˣdx = f(x) + C, then f(x) is —",
          "options": [
            "2ˣ",
            "2x logₑ2",
            "2ˣ/logₑ2",
            "2ˣ⁺¹/(x + 1)"
          ],
          "answer": "C",
          "years": [
            "April 2025"
          ],
          "work": "∫aˣdx = aˣ/log a."
        },
        {
          "id": "1.2",
          "type": "mcq",
          "q": "∫cos²x/(1 + sin x) dx equals —",
          "options": [
            "x − cos x + c",
            "x + cos x + c",
            "x + sin x + c",
            "x − sin x + c"
          ],
          "answer": "B",
          "years": [
            "April 2024"
          ],
          "work": "cos²x/(1 + sin x) = (1 − sin x)(1 + sin x)/(1 + sin x) = 1 − sin x.\n∫(1 − sin x)dx = x + cos x + c."
        },
        {
          "id": "1.3",
          "type": "mcq",
          "q": "∫(log x)²/x dx equals —",
          "options": [
            "(log x/3)³ + c",
            "log x³/3 + c",
            "(log x)³/3 + c",
            "(log(x/3))³ + c"
          ],
          "answer": "C",
          "years": [
            "April 2024"
          ],
          "work": "Put t = log x, dt = dx/x: ∫t²dt = t³/3 = (log x)³/3 + c."
        },
        {
          "id": "1.4",
          "type": "mcq",
          "q": "∫sin x dx is —",
          "options": [
            "cos x + c",
            "−cos x + c",
            "sin x + c",
            "tan x + c"
          ],
          "answer": "B",
          "years": [
            "April 2024"
          ]
        },
        {
          "id": "1.5",
          "type": "mcq",
          "q": "∫eˣ(1/x − 1/x²)dx equals —",
          "options": [
            "eˣ/x + c",
            "eˣ/x² + c",
            "eˣ log x + c",
            "−eˣ/x + c"
          ],
          "answer": "A",
          "years": [
            "April 2026"
          ],
          "work": "f(x) = 1/x has f'(x) = −1/x², so ∫eˣ[f + f']dx = eˣf(x) = eˣ/x + c."
        }
      ]
    },
