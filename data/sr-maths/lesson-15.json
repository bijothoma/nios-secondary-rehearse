        {
          "id": "1.1",
          "type": "mcq",
          "q": "If a circle passes through (0, 0), (a, 0) and (0, b), its centre is —",
          "options": [
            "(a, b)",
            "(−a/2, −b/2)",
            "(−a, −b)",
            "(a/2, b/2)"
          ],
          "answer": "D",
          "years": [
            "April 2026"
          ],
          "work": "The centre is equidistant from (0, 0) and (a, 0), so h = a/2; from (0, 0) and (0, b), so k = b/2."
        },
        {
          "id": "1.2",
          "type": "mcq",
          "q": "The radius of the circle 4x² + 4y² − 2x + 3y − 6 = 0 is —",
          "options": [
            "√37/4",
            "√109/8",
            "√71/6",
            "√107/8"
          ],
          "answer": "B",
          "years": [
            "October 2024"
          ],
          "work": "Divide by 4: x² + y² − x/2 + 3y/4 − 3/2 = 0 ⇒ g = −1/4, f = 3/8, c = −3/2.\nr² = 1/16 + 9/64 + 3/2 = 4/64 + 9/64 + 96/64 = 109/64 ⇒ r = √109/8."
        },
        {
          "id": "1.3",
          "type": "mcq",
          "q": "The centre and radius of x² + y² + 3x − y = 4 are —",
          "options": [
            "(−3/2, 1/2), √6/2",
            "(3/2, −1/2), √(13/2)",
            "(−3, 1), √14",
            "(−3/2, 1/2), √26/2"
          ],
          "answer": "D",
          "years": [
            "April 2024"
          ],
          "work": "g = 3/2, f = −1/2, c = −4. Centre (−3/2, 1/2).\nr² = 9/4 + 1/4 + 4 = 26/4 ⇒ r = √26/2."
        },
        {
          "id": "1.4",
          "type": "mcq",
          "q": "If (3, 4) is one end of a diameter of x² + y² + 2x − 4y − 15 = 0, the other end is —",
          "options": [
            "(5, 0)",
            "(0, 5)",
            "(−5, 0)",
            "(0, −5)"
          ],
          "answer": "C",
          "years": [
            "October 2025"
          ],
          "work": "Centre (−1, 2). Other end = (2·(−1) − 3, 2·2 − 4) = (−5, 0)."
        },
        {
          "id": "1.5",
          "type": "mcq",
          "q": "The equation of the circle with centre (2, −3) and radius 4 is —",
          "options": [
            "x² + y² − 4x + 6y − 3 = 0",
            "x² + y² + 4x − 6y − 3 = 0",
            "x² + y² − 4x + 6y + 3 = 0",
            "x² + y² − 4x − 6y − 3 = 0"
          ],
          "answer": "A",
          "work": "(x − 2)² + (y + 3)² = 16 ⇒ x² − 4x + 4 + y² + 6y + 9 = 16 ⇒ x² + y² − 4x + 6y − 3 = 0."
        }
      ]
    },
