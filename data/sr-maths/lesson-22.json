        {
          "id": "3.1",
          "type": "open",
          "q": "Using the matrix method, solve 5x − 7y = 3, x + 3y = 5.",
          "answer": "A = [[5, −7], [1, 3]], B = [3, 5]ᵀ. |A| = 15 + 7 = 22.\nA⁻¹ = (1/22)[[3, 7], [−1, 5]].\nX = A⁻¹B = (1/22)[3·3 + 7·5, −3 + 25] = (1/22)[44, 22] = [2, 1].\nx = 2, y = 1.",
          "years": [
            "April 2026"
          ]
        },
        {
          "id": "3.2",
          "type": "open",
          "q": "Using elementary row operations, find the inverse of A = [[3, 5], [4, 7]].",
          "answer": "Write A = IA.\nR₂ → R₂ − R₁: [[3, 5], [1, 2]] = [[1, 0], [−1, 1]]A.\nR₁ → R₁ − 3R₂: [[0, −1], [1, 2]] = [[4, −3], [−1, 1]]A.\nR₂ → R₂ + 2R₁: [[0, −1], [1, 0]] = [[4, −3], [7, −5]]A.\nR₁ → −R₁, then interchange R₁ and R₂: I = [[7, −5], [−4, 3]]A.\nA⁻¹ = [[7, −5], [−4, 3]]. (Check: |A| = 21 − 20 = 1 and adj A gives the same.)",
          "years": [
            "April 2026"
          ]
        },
        {
          "id": "3.3",
          "type": "open",
          "q": "Solve the matrix equation [[2, −3], [1, 1]][x, y]ᵀ = [1, 3]ᵀ.",
          "answer": "|A| = 2 + 3 = 5; A⁻¹ = (1/5)[[1, 3], [−1, 2]].\nX = (1/5)[1 + 9, −1 + 6] = (1/5)[10, 5] = [2, 1] ⇒ x = 2, y = 1.",
