        {
          "id": "1.1",
          "type": "mcq",
          "q": "If A = [[2, 5], [1, 3]], then A⁻¹ is —",
          "options": [
            "[[2, −1], [−5, 3]]",
            "[[3, −5], [−1, 2]]",
            "[[−3, 5], [1, −2]]",
            "[[2, −5], [−1, 3]]"
          ],
          "answer": "B",
          "years": [
            "April 2025"
          ],
          "work": "|A| = 6 − 5 = 1. adj A = [[3, −5], [−1, 2]]. A⁻¹ = adj A / 1."
        },
        {
          "id": "1.2",
          "type": "mcq",
          "q": "The value of k for which [[k, 2], [3, 4]] is invertible is —",
          "options": [
            "k = 2/3",
            "k ≠ 2/3",
            "k ≠ 3/2",
            "k = 3/2"
          ],
          "answer": "C",
          "years": [
            "April 2025"
          ],
          "work": "Invertible ⇔ |A| = 4k − 6 ≠ 0 ⇔ k ≠ 3/2."
        },
        {
          "id": "1.3",
          "type": "mcq",
          "q": "If I[x, y, z]ᵀ = [5, −4, 1]ᵀ, then x + y + z is —",
          "options": [
            "0",
            "−2",
            "1",
            "2"
          ],
          "answer": "D",
          "years": [
            "April 2024"
          ],
          "work": "I X = X, so x = 5, y = −4, z = 1 ⇒ x + y + z = 2."
        },
        {
          "id": "1.4",
          "type": "mcq",
          "q": "If A is invertible, (A⁻¹)⁻¹ is —",
          "options": [
            "A",
            "A'",
            "I",
            "adj A"
          ],
          "answer": "A",
          "years": [
            "October 2024"
          ]
        },
        {
          "id": "1.5",
          "type": "mcq",
          "q": "If A is a 3 × 3 matrix with |A| = 4, then |adj A| is —",
          "options": [
            "4",
            "8",
            "16",
            "64"
          ],
          "answer": "C",
          "work": "|adj A| = |A|ⁿ⁻¹ = 4² = 16 for n = 3."
        }
      ]
