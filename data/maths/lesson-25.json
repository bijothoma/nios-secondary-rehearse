      "questions": [
        {
          "id": "1.1",
          "type": "mcq",
          "q": "The mean of the first five prime numbers is —",
          "options": [
            "5",
            "5.2",
            "5.4",
            "5.6"
          ],
          "answer": "D",
          "years": [
            "April 2026"
          ],
          "work": "First five primes: 2, 3, 5, 7, 11. Sum = 28.\nMean = 28/5 = 5.6."
        },
        {
          "id": "1.2",
          "type": "mcq",
          "q": "The median of 10, 12, 14, 16, 18, 20 is —",
          "options": [
            "12",
            "14",
            "15",
            "16"
          ],
          "answer": "C",
          "years": [
            "April 2026",
            "April 2025",
            "October 2024"
          ],
          "work": "There are 6 values (even), so take the mean of the 3rd and 4th: (14 + 16)/2 = 15."
        },
        {
          "id": "1.3",
          "type": "mcq",
          "q": "The mean of the first five multiples of 7 is —",
          "options": [
            "20",
            "21",
            "22",
            "25"
          ],
          "answer": "B",
          "years": [
            "April 2025"
          ],
          "work": "7, 14, 21, 28, 35: sum = 105; mean = 105/5 = 21. (For an A.P. of odd length, the mean is the middle term.)"
        },
        {
          "id": "1.4",
          "type": "mcq",
          "q": "The mean of 5 observations is 15. The mean of the first three is 14 and of the last three is 17. The third observation is —",
          "options": [
            "15",
            "16",
            "18",
            "20"
          ],
          "answer": "C",
          "years": [
            "October 2025"
          ],
          "work": "Total = 5 × 15 = 75. First three = 42; last three = 51.\n42 + 51 counts the third observation twice: 93 − 75 = 18."
        },
        {
          "id": "1.5",
          "type": "mcq",
          "q": "If the mean of 6, 7, p, 8, q, 14 is 9, then —",
          "options": [
            "p − q = 19",
            "p + q = 19",
            "p − q = 15",
            "p + q = 15"
          ],
          "answer": "B",
          "years": [
            "October 2025"
          ],
          "work": "Sum = 35 + p + q = 6 × 9 = 54 ⇒ p + q = 19."
        },
        {
          "id": "1.6",
          "type": "mcq",
          "q": "The middle-most observation of ordered data is the —",
          "options": [
            "mean",
            "median",
            "mode",
            "range"
          ],
          "answer": "B",
          "years": [
            "October 2025"
          ],
          "work": "By definition the median is the middle value of data arranged in order."
        },
        {
          "id": "1.7",
          "type": "mcq",
          "q": "Which of the following is NOT a measure of central tendency?",
          "options": [
            "Mean",
            "Median",
            "Mode",
            "Range"
          ],
          "answer": "D",
          "years": [
            "October 2024",
            "April 2024"
          ],
          "work": "Mean, median and mode describe the centre. Range (highest − lowest) measures spread. (April 2024 asked the same with 'class mark'.)"
        },
        {
          "id": "1.8",
          "type": "mcq",
          "q": "The mode of 2, 7, 5, 9, 5, 7, 8, 11, 5 is —",
          "options": [
            "7",
            "5",
            "8",
            "9"
          ],
          "answer": "B",
          "years": [
            "April 2024"
          ],
          "work": "5 occurs three times, 7 twice, others once. Mode = 5."
        },
        {
          "id": "1.9",
          "type": "mcq",
          "q": "If the mean of x₁, x₂, …, x₁₀ is 20, the mean of x₁ + 4, x₂ + 4, …, x₁₀ + 4 is —",
          "options": [
            "20",
            "24",
            "40",
            "80"
          ],
          "answer": "B",
          "years": [
            "October 2021"
          ],
          "work": "Adding 4 to every value adds 4 to the mean: 20 + 4 = 24."
        },
        {
          "id": "1.10",
          "type": "mcq",
          "q": "If the mean of grouped data is 27 and the mode is 45, the median is —",
          "options": [
            "33",
            "36",
            "39",
            "30"
          ],
          "answer": "A",
          "years": [
            "April 2022"
          ],
          "work": "Mode = 3 median − 2 mean ⇒ 45 = 3M − 54 ⇒ 3M = 99 ⇒ M = 33."
        }
      ]
    },
